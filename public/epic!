local function GetPlayerRole(p)
    local role, hasItem = "innocent", false
    for _, c in ipairs({p.Character, p:FindFirstChildOfClass("Backpack")}) do
        if c then
            for _, v in ipairs(c:GetDescendants()) do
                if v:IsA("Tool") then
                    hasItem = true
                    local n = v.Name:lower()
                    if n:find("watchdog", 1, true) then
                        role = "watchdog"
                    elseif n:sub(1, 3) == "mu_" and role ~= "watchdog" then
                        role = "murder"
                    end
                end
            end
        end
    end
    return (role == "innocent" and hasItem) and "sheriff" or role
end

local function isValidTarget(model)
    if not model or model == LocalPlayer.Character then return false, nil end
    local player = Players:GetPlayerFromCharacter(model)
    if Toggles.MurderCheck then
        if GetPlayerRole(player) ~= "murder" then
            return false, nil
        end
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local head = model:FindFirstChild("Head")
    if humanoid and head and humanoid.Health > 0 then
        return true, head
    end
    return false, nil
end

local function getClosestHeadInFOV()
    local mousePos = UserInputService:GetMouseLocation()
    local closestHead = nil
    local shortestDistance = cfg.FOVRadius

    local function checkModel(model)
        local valid, head = isValidTarget(model)
        if not valid then return end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then return end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist < shortestDistance then
            shortestDistance = dist
            closestHead = head
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            checkModel(player.Character)
        end
    end

    local npcFolder = workspace:FindFirstChild("NPCs")
    if npcFolder then
        for _, npc in ipairs(npcFolder:GetChildren()) do
            checkModel(npc)
        end
    end

    return closestHead
end

local function buildFilterList(character)
    local filterList = { character, Camera }

    local debris = workspace:FindFirstChild("Debris")
    if debris then
        table.insert(filterList, debris)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Tool") then
                    table.insert(filterList, item)
                end
            end
        end
    end

    return filterList
end

local function fireTargetedShot(targetHead)
    local character = getcharacter()
    if not character or not character.PrimaryPart then return end

    local tool = character:FindFirstChildOfClass("Tool")
    if not tool then return end

    local remote = tool:FindFirstChild("Remote")
    if not remote then return end

    local startPos = (character.PrimaryPart.CFrame * CFrame.new(0, 1.5, 0)).Position
    local offset = targetHead.Position - startPos
    local direction = offset.Unit
    local maxDist = offset.Magnitude + 10

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.CollisionGroup = "Raycasts"
    params.FilterDescendantsInstances = buildFilterList(character)

    local rayResult = workspace:Raycast(startPos, direction * maxDist, params)
    if not rayResult then return end

    local hitInstance = rayResult.Instance
    local hitSize = hitInstance:IsA("BasePart") and hitInstance.Size or Vector3.zero

    local config = tool:FindFirstChild("Config")
    local spread = config and config:GetAttribute("Spread") or 0

    remote:FireServer({{
            StartPos      = startPos,
            Position      = rayResult.Position,
            Instance      = hitInstance,
            Distance      = rayResult.Distance,
            ClientHitSize = hitSize,
            Normal        = rayResult.Normal,
            Material      = rayResult.Material}}, spread)
end

